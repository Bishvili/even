#define name Health Check
#define color orange
#define glyph heart
#define mac false

#include 'actions/text'

#ref stepsFilter 
#ref restingFilter 
#ref hrvFilter 
#ref exerciseFilter 
#ref sleepFilter 
#ref recentTypesFilter 

#ref notStepsFilter 

#ref anyRemovable 
#ref anyUnbounded 
#ref anyWithDate 
#ref anyDateOnly 

action 'is.workflow.actions.filter.health.quantity' findNewest(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":5,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.filter.health.quantity' findManyNewest(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1000,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.filter.health.quantity' findByDay(&variable filter: 'WFContentItemFilter'): array {"WFHKSampleFilteringGroupBy":"Day","WFHKSampleFilteringFillMissing":true,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First","WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1}

action 'is.workflow.actions.properties.health.quantity' sampleTypes(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Type"}
action 'is.workflow.actions.properties.health.quantity' sampleValues(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Value"}
action 'is.workflow.actions.properties.health.quantity' sampleStarts(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Start Date"}

// Nothing leaves the iPhone: every result is shown here and only here.
const options = list("Resting Heart Rate", "Sleep", "Heart Rate Variability", "Exercise Minutes", "Steps", "All five together", "Test 1: empty type, plain", "Test 2: empty type, by day", "Test 3: everything but Steps", "Test 4: any, extra rows removable", "Test 5: any, extra rows free", "Test 6: any, five types and a date", "Test 7: any, Steps or a date")
const chosen = chooseFromList(options, "Check which Health data? Run this once for each.")
const choice = getText(chosen)
const notice = "If no result appears after this, iOS returned nothing for this type: either no samples, or no access."

if choice == "Resting Heart Rate" {
    alert("{notice}", "Checking Resting Heart Rate")
    const restingSamples = findNewest(restingFilter)
    const restingCount = count(restingSamples)
    const restingTypes = sampleTypes(restingSamples)
    const restingValues = sampleValues(restingSamples)
    const restingStarts = sampleStarts(restingSamples)
    alert("Found {restingCount} (up to 5).\n\nTypes:\n{restingTypes}\n\nValues:\n{restingValues}\n\nStarts:\n{restingStarts}", "Resting Heart Rate")
}

if choice == "Sleep" {
    alert("{notice}", "Checking Sleep")
    const sleepSamples = findNewest(sleepFilter)
    const sleepCount = count(sleepSamples)
    const sleepTypes = sampleTypes(sleepSamples)
    const sleepValues = sampleValues(sleepSamples)
    const sleepStarts = sampleStarts(sleepSamples)
    alert("Found {sleepCount} (up to 5).\n\nTypes:\n{sleepTypes}\n\nValues:\n{sleepValues}\n\nStarts:\n{sleepStarts}", "Sleep")
}

if choice == "Heart Rate Variability" {
    alert("{notice}", "Checking Heart Rate Variability")
    const hrvSamples = findNewest(hrvFilter)
    const hrvCount = count(hrvSamples)
    const hrvTypes = sampleTypes(hrvSamples)
    const hrvValues = sampleValues(hrvSamples)
    const hrvStarts = sampleStarts(hrvSamples)
    alert("Found {hrvCount} (up to 5).\n\nTypes:\n{hrvTypes}\n\nValues:\n{hrvValues}\n\nStarts:\n{hrvStarts}", "Heart Rate Variability")
}

if choice == "Exercise Minutes" {
    alert("{notice}", "Checking Exercise Minutes")
    const exerciseSamples = findNewest(exerciseFilter)
    const exerciseCount = count(exerciseSamples)
    const exerciseTypes = sampleTypes(exerciseSamples)
    const exerciseValues = sampleValues(exerciseSamples)
    const exerciseStarts = sampleStarts(exerciseSamples)
    alert("Found {exerciseCount} (up to 5).\n\nTypes:\n{exerciseTypes}\n\nValues:\n{exerciseValues}\n\nStarts:\n{exerciseStarts}", "Exercise Minutes")
}

if choice == "Steps" {
    alert("{notice}", "Checking Steps")
    const stepsSamples = findNewest(stepsFilter)
    const stepsCount = count(stepsSamples)
    const stepsTypes = sampleTypes(stepsSamples)
    const stepsValues = sampleValues(stepsSamples)
    const stepsStarts = sampleStarts(stepsSamples)
    alert("Found {stepsCount} (up to 5).\n\nTypes:\n{stepsTypes}\n\nValues:\n{stepsValues}\n\nStarts:\n{stepsStarts}", "Steps")
}

if choice == "All five together" {
    alert("{notice}", "Checking all five")
    const allSamples = findManyNewest(recentTypesFilter)
    const allCount = count(allSamples)
    const allTypes = sampleTypes(allSamples)
    const allTypeText = getText(allTypes)
    const restingSeen = matchText('(?i)resting', allTypeText)
    const restingSeenCount = count(restingSeen)
    const sleepSeen = matchText('(?i)sleep', allTypeText)
    const sleepSeenCount = count(sleepSeen)
    const stepsSeen = matchText('(?i)steps', allTypeText)
    const stepsSeenCount = count(stepsSeen)
    alert("Newest {allCount} samples.\n\nSteps: {stepsSeenCount}\nResting: {restingSeenCount}\nSleep: {sleepSeenCount}", "All five")
}

if choice == "Test 1: empty type, plain" {
    alert("If no second message appears, an empty type ends the run.", "Test 1")
    const plainSamples = findNewest(hrvFilter)
    const plainCount = count(plainSamples)
    alert("Still running. Found {plainCount}.", "Test 1 result")
}

if choice == "Test 2: empty type, by day" {
    alert("If no second message appears, this way ends the run too.", "Test 2")
    const dayEmpty = findByDay(hrvFilter)
    const dayEmptyCount = count(dayEmpty)
    const dayEmptyValues = sampleValues(dayEmpty)
    alert("Still running with no data. Found {dayEmptyCount}, value: {dayEmptyValues}.", "Test 2, no data")
    const dayFull = findByDay(restingFilter)
    const dayFullCount = count(dayFull)
    const dayFullValues = sampleValues(dayFull)
    alert("With data. Found {dayFullCount}, value: {dayFullValues}.", "Test 2, data")
}

if choice == "Test 3: everything but Steps" {
    alert("If no second message appears, this way ends the run.", "Test 3")
    const otherSamples = findManyNewest(notStepsFilter)
    const otherCount = count(otherSamples)
    const otherTypes = sampleTypes(otherSamples)
    const otherText = getText(otherTypes)
    const otherResting = matchText('(?i)resting', otherText)
    const otherRestingCount = count(otherResting)
    const otherSleep = matchText('(?i)sleep', otherText)
    const otherSleepCount = count(otherSleep)
    const otherSteps = matchText('(?i)steps', otherText)
    const otherStepsCount = count(otherSteps)
    alert("Found {otherCount}.\n\nSteps: {otherStepsCount}\nResting: {otherRestingCount}\nSleep: {otherSleepCount}", "Test 3 result")
}

if choice == "Test 4: any, extra rows removable" {
    const t4Samples = findManyNewest(anyRemovable)
    const t4Count = count(t4Samples)
    const t4Types = sampleTypes(t4Samples)
    const t4Text = getText(t4Types)
    const t4Resting = matchText('(?i)resting', t4Text)
    const t4RestingCount = count(t4Resting)
    const t4Sleep = matchText('(?i)sleep', t4Text)
    const t4SleepCount = count(t4Sleep)
    const t4Steps = matchText('(?i)steps', t4Text)
    const t4StepsCount = count(t4Steps)
    alert("Found {t4Count}.\n\nSteps: {t4StepsCount}\nResting: {t4RestingCount}\nSleep: {t4SleepCount}", "Test 4 result")
}

if choice == "Test 5: any, extra rows free" {
    const t5Samples = findManyNewest(anyUnbounded)
    const t5Count = count(t5Samples)
    const t5Types = sampleTypes(t5Samples)
    const t5Text = getText(t5Types)
    const t5Resting = matchText('(?i)resting', t5Text)
    const t5RestingCount = count(t5Resting)
    const t5Sleep = matchText('(?i)sleep', t5Text)
    const t5SleepCount = count(t5Sleep)
    const t5Steps = matchText('(?i)steps', t5Text)
    const t5StepsCount = count(t5Steps)
    alert("Found {t5Count}.\n\nSteps: {t5StepsCount}\nResting: {t5RestingCount}\nSleep: {t5SleepCount}", "Test 5 result")
}

if choice == "Test 6: any, five types and a date" {
    const t6Samples = findManyNewest(anyWithDate)
    const t6Count = count(t6Samples)
    const t6Types = sampleTypes(t6Samples)
    const t6Text = getText(t6Types)
    const t6Resting = matchText('(?i)resting', t6Text)
    const t6RestingCount = count(t6Resting)
    const t6Sleep = matchText('(?i)sleep', t6Text)
    const t6SleepCount = count(t6Sleep)
    const t6Steps = matchText('(?i)steps', t6Text)
    const t6StepsCount = count(t6Steps)
    alert("Found {t6Count}.\n\nSteps: {t6StepsCount}\nResting: {t6RestingCount}\nSleep: {t6SleepCount}", "Test 6 result")
}

if choice == "Test 7: any, Steps or a date" {
    const t7Samples = findManyNewest(anyDateOnly)
    const t7Count = count(t7Samples)
    const t7Types = sampleTypes(t7Samples)
    const t7Text = getText(t7Types)
    const t7Resting = matchText('(?i)resting', t7Text)
    const t7RestingCount = count(t7Resting)
    const t7Sleep = matchText('(?i)sleep', t7Text)
    const t7SleepCount = count(t7Sleep)
    const t7Steps = matchText('(?i)steps', t7Text)
    const t7StepsCount = count(t7Steps)
    alert("Found {t7Count}.\n\nSteps: {t7StepsCount}\nResting: {t7RestingCount}\nSleep: {t7SleepCount}", "Test 7 result")
}
