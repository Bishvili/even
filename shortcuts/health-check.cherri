const p3SleepCount = count(p3Sleep)
const p3Steps = matchText('(?i)steps', p3Text)
const p3StepsCount = count(p3Steps)
alert("Data and empty: {p3Count} found.\nSteps {p3StepsCount}, Resting {p3RestingCount}, Sleep {p3SleepCount}.", "Search 3 of 4")

const p6Samples = findManyNewest(pair6)
