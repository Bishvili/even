const p6Steps = matchText('(?i)steps', p6Text)
const p6StepsCount = count(p6Steps)
alert("Two empty types: {p6Count} found.\nSteps {p6StepsCount}, Resting {p6RestingCount}, Sleep {p6SleepCount}.", "Search 4 of 4")

