#define name Health Check
#define color orange
#define glyph heart
#define mac false

#include 'actions/text'

#ref anyRemovable 
#ref anyUnbounded 
#ref anyWithDate 
#ref anyDateOnly 

action 'is.workflow.actions.filter.health.quantity' findManyNewest(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1000,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.properties.health.quantity' sampleTypes(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Type"}

// Four forms of a search across Health types, one after another. Nothing leaves the iPhone: the report is shown here and only here.
const t1Samples = findManyNewest(anyRemovable)
const t1Count = count(t1Samples)
const t1Types = sampleTypes(t1Samples)
const t1Text = getText(t1Types)
const t1Resting = matchText('(?i)resting', t1Text)
const t1RestingCount = count(t1Resting)
const t1Sleep = matchText('(?i)sleep', t1Text)
const t1SleepCount = count(t1Sleep)
const t1Steps = matchText('(?i)steps', t1Text)
const t1StepsCount = count(t1Steps)

const t2Samples = findManyNewest(anyUnbounded)
const t2Count = count(t2Samples)
const t2Types = sampleTypes(t2Samples)
const t2Text = getText(t2Types)
const t2Resting = matchText('(?i)resting', t2Text)
const t2RestingCount = count(t2Resting)
const t2Sleep = matchText('(?i)sleep', t2Text)
const t2SleepCount = count(t2Sleep)
const t2Steps = matchText('(?i)steps', t2Text)
const t2StepsCount = count(t2Steps)

const t3Samples = findManyNewest(anyWithDate)
const t3Count = count(t3Samples)
const t3Types = sampleTypes(t3Samples)
const t3Text = getText(t3Types)
const t3Resting = matchText('(?i)resting', t3Text)
const t3RestingCount = count(t3Resting)
const t3Sleep = matchText('(?i)sleep', t3Text)
const t3SleepCount = count(t3Sleep)
const t3Steps = matchText('(?i)steps', t3Text)
const t3StepsCount = count(t3Steps)

const t4Samples = findManyNewest(anyDateOnly)
const t4Count = count(t4Samples)
const t4Types = sampleTypes(t4Samples)
const t4Text = getText(t4Types)
const t4Resting = matchText('(?i)resting', t4Text)
const t4RestingCount = count(t4Resting)
const t4Sleep = matchText('(?i)sleep', t4Text)
const t4SleepCount = count(t4Sleep)
const t4Steps = matchText('(?i)steps', t4Text)
const t4StepsCount = count(t4Steps)

alert("Search 1: {t1Count} found. Steps {t1StepsCount}, Resting {t1RestingCount}, Sleep {t1SleepCount}.\n\nSearch 2: {t2Count} found. Steps {t2StepsCount}, Resting {t2RestingCount}, Sleep {t2SleepCount}.\n\nSearch 3: {t3Count} found. Steps {t3StepsCount}, Resting {t3RestingCount}, Sleep {t3SleepCount}.\n\nSearch 4: {t4Count} found. Steps {t4StepsCount}, Resting {t4RestingCount}, Sleep {t4SleepCount}.", "Health Check")
