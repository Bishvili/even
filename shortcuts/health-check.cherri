#define name Health Check
#define color orange
#define glyph heart
#define mac false

#include 'actions/text'

#ref pair3 
#ref pair4 
#ref pair5 
#ref pair6 

action 'is.workflow.actions.filter.health.quantity' findManyNewest(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1000,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.properties.health.quantity' sampleTypes(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Type"}

// Each search shows its own result, so a search that ends the run is the one after the last result shown. Nothing leaves the iPhone.
const p4Samples = findManyNewest(pair4)
const p4Count = count(p4Samples)
const p4Types = sampleTypes(p4Samples)
const p4Text = getText(p4Types)
const p4Resting = matchText('(?i)resting', p4Text)
const p4RestingCount = count(p4Resting)
const p4Sleep = matchText('(?i)sleep', p4Text)
const p4SleepCount = count(p4Sleep)
const p4Steps = matchText('(?i)steps', p4Text)
const p4StepsCount = count(p4Steps)
alert("Steps and Resting: {p4Count} found.\nSteps {p4StepsCount}, Resting {p4RestingCount}, Sleep {p4SleepCount}.", "Search 1 of 4")

const p5Samples = findManyNewest(pair5)
const p5Count = count(p5Samples)
const p5Types = sampleTypes(p5Samples)
const p5Text = getText(p5Types)
const p5Resting = matchText('(?i)resting', p5Text)
const p5RestingCount = count(p5Resting)
const p5Sleep = matchText('(?i)sleep', p5Text)
const p5SleepCount = count(p5Sleep)
const p5Steps = matchText('(?i)steps', p5Text)
const p5StepsCount = count(p5Steps)
alert("Resting and Sleep: {p5Count} found.\nSteps {p5StepsCount}, Resting {p5RestingCount}, Sleep {p5SleepCount}.", "Search 2 of 4")

