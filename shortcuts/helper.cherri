#define name Even Release
#define color teal
#define glyph key
#define mac false

#include 'actions/documents'
#include 'actions/shortcuts'
#include 'actions/text'
#include 'actions/web'

#ref onMyIPhone eyJkaXNwbGF5TmFtZSI6Ik9uIE15IGlQaG9uZSIsImZpbGVuYW1lIjoiRmlsZSBQcm92aWRlciBTdG9yYWdlIiwiZmlsZUxvY2F0aW9uIjp7IldGRmlsZUxvY2F0aW9uVHlwZSI6IkxvY2FsU3RvcmFnZSIsInJlbGF0aXZlU3VicGF0aCI6IiJ9fQ==

action 'is.workflow.actions.file.createfolder' createKeyFolder(&variable location: 'WFFolder') {"WFFilePath":"Even"}

action 'is.workflow.actions.documentpicker.open' readSavedDeviceKey(&variable folder: 'WFFile'): text {"WFGetFilePath":"even-device-key.txt","WFFileErrorIfNotFound":false,"WFShowFilePicker":false}

// Change this with every change to the helper, so it can update itself and share the new link.
const helperVersion = "2.3.0"
const appAddress = "https://even.bishvili.org"

// Updating needs no connection, so the helper can always replace itself first.
const latestHelperRaw = downloadURL("{appAddress}/api/shortcut/build/helper/version")
const latestHelperText = getText(latestHelperRaw)
const latestHelper = replaceText('\s+', "", latestHelperText, true, true)
const latestHelperLength = count(latestHelper, "Characters")
if latestHelperLength >= 1 {
    if latestHelper != helperVersion {
        showNotification("Tap Replace, then run this helper again.", "Even Release")
        const newHelperBuild = downloadURL("{appAddress}/api/shortcut/build/helper")
        const newHelperName = setName(newHelperBuild, "Even Release.shortcut")
        openFile(newHelperName)
        stop()
    }
}

const keyFolder = createKeyFolder(onMyIPhone)

// Look up Shortcuts by their exact names, so no other Shortcut can be chosen.
const allShortcuts = getShortcuts()
@hasSync = 0
for candidate in allShortcuts {
    const candidateName = getShortcutDetail(@candidate, "Name")
    const candidateText = getText(candidateName)
    if candidateText == "Even Sync" {
        @hasSync = 1
    }
}

@state = "install"
@credential = ""
@latest = ""
@helperLinkState = "current"
if @hasSync == 1 {
    // Running it reports the installed version and shows its result before anything goes public.
    const runRequest = text("release check")
    run("Even Sync", runRequest)

    const savedKeyFile = readSavedDeviceKey(keyFolder)
    @credential = getText(savedKeyFile)
    const stateRaw = downloadURL("{appAddress}/api/shortcut/release-state?helper={helperVersion}", {"Authorization": "{@credential}"})
    const stateInfo = getDictionary(stateRaw)
    const stateValue = getValue(stateInfo, "state")
    @state = getText(stateValue)
    const latestValue = getValue(stateInfo, "latest")
    @latest = getText(latestValue)
    const helperLinkValue = getValue(stateInfo, "helperLinkState")
    @helperLinkState = getText(helperLinkValue)
}

// Share this version's link once, so Set Up Release Helper installs it for other developers.
if @helperLinkState == "share" {
    @helperLink = ""
    for helperCandidate in allShortcuts {
        const helperName = getShortcutDetail(@helperCandidate, "Name")
        const helperText = getText(helperName)
        if helperText == "Even Release" {
            const helperLinkResult = createShortcutLink(@helperCandidate)
            @helperLink = getText(helperLinkResult)
        }
    }
    const sharedRaw = jsonRequest("{appAddress}/api/shortcut/helper-link", "POST", {
        "link": "{@helperLink}"
    }, {"Authorization": "{@credential}"})
    const shared = getDictionary(sharedRaw)
    const sharedErrorValue = getValue(shared, "error")
    const sharedError = getText(sharedErrorValue)
    const sharedErrorLength = count(sharedError, "Characters")
    if sharedErrorLength >= 1 {
        showNotification("{sharedError}", "Even Release")
    }
}

if @state == "install" {
    showNotification("Tap Replace, then run this helper again.", "Even Release")
    const build = downloadURL("{appAddress}/api/shortcut/build/sync")
    const namedBuild = setName(build, "Even Sync.shortcut")
    openFile(namedBuild)
    stop()
}

if @state == "building" {
    alert("The new build is still being signed. Try again in a few minutes.", "Even Release")
    stop()
}

if @state == "ahead" {
    alert("This iPhone has a newer Even Sync than the latest build, so there's nothing to install.", "Even Release")
    stop()
}

if @state == "current" {
    alert("The latest version is installed and published.", "Even Release")
    stop()
}

if @state != "publish" {
    alert("Open Even, go to Data, and tap Run Even Sync, then try again.", "Couldn't check the version")
    stop()
}

const confirmOptions = list("Publish", "Cancel")
const confirmed = chooseFromList(confirmOptions, "Did Even Sync work? This publishes version {@latest}.")
const decision = getText(confirmed)
if decision != "Publish" {
    stop()
}

@shareLink = ""
for linkCandidate in allShortcuts {
    const linkName = getShortcutDetail(@linkCandidate, "Name")
    const linkText = getText(linkName)
    if linkText == "Even Sync" {
        const linkResult = createShortcutLink(@linkCandidate)
        @shareLink = getText(linkResult)
    }
}

const publishRaw = jsonRequest("{appAddress}/api/shortcut/publish", "POST", {
    "link": "{@shareLink}"
}, {"Authorization": "{@credential}"})
const publish = getDictionary(publishRaw)
const errorValue = getValue(publish, "error")
const errorText = getText(errorValue)
const errorLength = count(errorText, "Characters")
if errorLength >= 1 {
    alert("{errorText}", "Publishing didn't start")
    stop()
}
showNotification("Publishing version {@latest}. This takes a few minutes.", "Even Release")

// Wait until the app offers the new version, checking every 20 seconds for up to four minutes.
@live = 0
repeat attempt for 12 {
    if @live == 0 {
        wait(20)
        const checkRaw = downloadURL("{appAddress}/api/shortcut/release-state?helper={helperVersion}", {"Authorization": "{@credential}"})
        const checkInfo = getDictionary(checkRaw)
        const checkValue = getValue(checkInfo, "state")
        const checkState = getText(checkValue)
        if checkState == "current" {
            @live = 1
        }
    }
}
if @live == 1 {
    alert("Version {@latest} is live.", "Even Release")
} else {
    alert("Publishing is still running. Run this helper again in a few minutes to check.", "Even Release")
}
