#define name Rage Tracker Sync
#define color teal
#define glyph heart
#define mac false

#include 'actions/calendar'
#include 'actions/math'
#include 'actions/text'
#include 'actions/web'

// The credential is configured by Apple Shortcuts when the user installs the workflow.
#question authorization "Paste the full Authorization value from Rage Tracker > Sync" "Bearer "

// A public connectivity check keeps the import question attached to the next Text action.
downloadURL("https://rage-tracker.bishvili.workers.dev/api/status")
const credential = text(authorization)

// Every run verifies the credential before requesting Health or Calendar information.
const profileRaw = downloadURL("https://rage-tracker.bishvili.workers.dev/api/profile", {"Authorization": "{credential}"})
const profile = getDictionary(profileRaw)
@authorized: bool
@authorized = getValue(profile, "ok")
if @authorized == false {
    alert("This device key was not accepted. Copy a new Authorization value from Rage Tracker and customize this Shortcut.", "Connection failed")
    stop()
}

// Collect only events starting today.
action 'is.workflow.actions.filter.calendarevents' findTodayEvents(): array {"WFContentItemFilter":{"Value":{"WFActionParameterFilterPrefix":1,"WFContentPredicateBoundedDate":false,"WFActionParameterFilterTemplates":[{"Bounded":true,"Operator":1002,"Property":"Start Date","Removable":false,"Values":{"Number":"7","Unit":16}}]},"WFSerializationType":"WFContentPredicateTableTemplate"},"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":30,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Ascending"}

// Use the native Health sample-type picker. This is not a free-text filter.
action 'is.workflow.actions.filter.health.quantity' findTodaySteps(): array {"WFContentItemFilter":{"Value":{"WFActionParameterFilterPrefix":1,"WFContentPredicateBoundedDate":false,"WFActionParameterFilterTemplates":[{"Bounded":true,"Operator":4,"Property":"Type","Removable":false,"Values":{"Enumeration":{"Value":"Steps","WFSerializationType":"WFStringSubstitutableState"}}},{"Bounded":true,"Operator":1002,"Property":"Start Date","Removable":false,"Values":{"Number":"7","Unit":16}}]},"WFSerializationType":"WFContentPredicateTableTemplate"}}

action 'is.workflow.actions.properties.health.quantity' getStepValues(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Value"}

@acceptedCount = 0
const events = findTodayEvents()
for event in events {
    const title = getEventDetail(@event, "Title")
    const startDate = getEventDetail(@event, "Start Date")
    const endDate = getEventDetail(@event, "End Date")
    const startISO = formatDate(startDate, "ISO 8601")
    const endISO = formatDate(endDate, "ISO 8601")

    const eventBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
        "kind": "calendar",
        "shortcutVersion": "2.1.0",
        "title": "{title}",
        "start": "{startISO}",
        "end": "{endISO}"
    }, {"Authorization": "{credential}"})
    const eventResponse = getDictionary(eventBody)
    @eventAccepted: bool
    @eventAccepted = getValue(eventResponse, "ok")
    if @eventAccepted == true {
        @acceptedCount += 1
    } else {
        alert("The server rejected an event. Check your Calendar permissions and its start/end times.", "Sync stopped")
        stop()
    }
}

const samples = findTodaySteps()
const sampleCount = count(samples)
if sampleCount > 0 {
    const values = getStepValues(samples)
    const totalSteps = statistic("Sum", values)
    const today = currentDate()
    const day = formatDate(today, "Custom", "yyyy-MM-dd")
    const healthBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
        "kind": "health",
        "shortcutVersion": "2.1.0",
        "date": "{day}",
        "steps": "{totalSteps}"
    }, {"Authorization": "{credential}"})
    const healthResponse = getDictionary(healthBody)
    @healthAccepted: bool
    @healthAccepted = getValue(healthResponse, "ok")
    if @healthAccepted == true {
        @acceptedCount += 1
    } else {
        alert("The server rejected the step total. Check Health access and the reported values.", "Sync stopped")
        stop()
    }
}

showNotification("Rage Tracker accepted {@acceptedCount} updates.", "Rage Tracker")

// Offer an update after syncing; the user approves installation in Apple Shortcuts.
const releaseBody = downloadURL("https://rage-tracker.bishvili.workers.dev/api/shortcut/release?current=2.1.0", {"Authorization": "{credential}"})
const releaseInfo = getDictionary(releaseBody)
@updateAvailable: bool
@updateAvailable = getValue(releaseInfo, "updateAvailable")
if @updateAvailable == true {
    @release = getValue(releaseInfo, "release")
    @link = @release['url']
    const updateOptions = list("Install update", "Not now")
    const selected = chooseFromList(updateOptions, "An updated Rage Tracker Sync is available.")
    @selection = getText(selected)
    if @selection == "Install update" {
        openURL("{link}")
    }
}
