#define name Rage Tracker Sync
#define color teal
#define glyph heart
#define mac false

#include 'actions/calendar'
#include 'actions/text'
#include 'actions/web'

// Filters are passed as references because Cherri rewrites nested action parameters.
#ref todayEventsFilter 
#ref stepsFilter 
#ref restingFilter 
#ref hrvFilter 
#ref exerciseFilter 
#ref sleepFilter 
#ref recentTypesFilter 

// The device key lives in a file outside this Shortcut, in On My iPhone so it works without iCloud Drive.
#ref onMyIPhone eyJkaXNwbGF5TmFtZSI6Ik9uIE15IGlQaG9uZSIsImZpbGVuYW1lIjoiRmlsZSBQcm92aWRlciBTdG9yYWdlIiwiZmlsZUxvY2F0aW9uIjp7IldGRmlsZUxvY2F0aW9uVHlwZSI6IkxvY2FsU3RvcmFnZSIsInJlbGF0aXZlU3VicGF0aCI6IiJ9fQ==

action 'is.workflow.actions.file.createfolder' createKeyFolder(&variable location: 'WFFolder') {"WFFilePath":"Rage Tracker"}

action 'is.workflow.actions.documentpicker.open' readSavedDeviceKey(&variable folder: 'WFFile'): text {"WFGetFilePath":"rage-tracker-device-key.txt","WFFileErrorIfNotFound":false,"WFShowFilePicker":false}

action 'is.workflow.actions.documentpicker.save' saveDeviceKey(variable key: 'WFInput', &variable folder: 'WFFolder') {"WFFileDestinationPath":"rage-tracker-device-key.txt","WFSaveFileOverwrite":true,"WFAskWhereToSave":false}

const keyFolder = createKeyFolder(onMyIPhone)
// Running from the app passes the key as input, so nothing needs pasting.
@credential = getText(ShortcutInput)
const providedKeyMatches = matchText('^Bearer [0-9A-Fa-f]{64}$', @credential)
const providedKeyCount = count(providedKeyMatches)
if providedKeyCount == 0 {
    const savedKeyFile = readSavedDeviceKey(keyFolder)
    @credential = getText(savedKeyFile)
    const savedKeyMatches = matchText('^Bearer [0-9A-Fa-f]{64}$', @credential)
    const savedKeyMatchCount = count(savedKeyMatches)
    if savedKeyMatchCount == 0 {
        @credential = prompt("Paste your device key from Rage Tracker > Sync")
    }
}

// Verify the connection and record the Shortcut's version, even if no health samples are available.
const handshakeRaw = jsonRequest("https://rage-tracker.bishvili.workers.dev/api/shortcut/hello", "POST", {
    "shortcutVersion": "2.3.9"
}, {"Authorization": "{@credential}"})
const handshake = getDictionary(handshakeRaw)
const connectionStatusValue = getValue(handshake, "state")
const connectionStatus = getText(connectionStatusValue)
if connectionStatus != "connected" {
    @credential = prompt("That key didn't work. Paste your device key from Rage Tracker > Sync")
    const retryRaw = jsonRequest("https://rage-tracker.bishvili.workers.dev/api/shortcut/hello", "POST", {
        "shortcutVersion": "2.3.9"
    }, {"Authorization": "{@credential}"})
    const retry = getDictionary(retryRaw)
    const retryStatusValue = getValue(retry, "state")
    const retryStatus = getText(retryStatusValue)
    if retryStatus != "connected" {
        alert("That key didn't work. Generate a new one in Rage Tracker > Sync.", "Not connected")
        stop()
    }
}

// Save only a key the server accepted, so a failed attempt cannot replace a working one.
saveDeviceKey(@credential, keyFolder)

// Collect only events starting today.
action 'is.workflow.actions.filter.calendarevents' findEvents(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":30,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Oldest First"}

// Daily groups over 30 days give Health's own totals, and a quiet day doesn't end the run.
// The newest group is usually today, so each value is sent under its group's own date.
// A result limit would apply before grouping and return a single sample.
action 'is.workflow.actions.filter.health.quantity' findLatestDay(&variable filter: 'WFContentItemFilter'): array {"WFHKSampleFilteringGroupBy":"Day","WFHKSampleFilteringFillMissing":true,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.filter.health.quantity' findSamples(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":60,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

// The newest samples of any type. A filter can't both match several types and limit dates, so a result limit bounds it.
action 'is.workflow.actions.filter.health.quantity' findRecentSamples(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1000,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.properties.health.quantity' getSampleTypes(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Type"}

action 'is.workflow.actions.properties.health.quantity' getStepValues(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Value"}

action 'is.workflow.actions.properties.health.quantity' getSampleValue(variable sample: 'WFInput') {"WFContentItemPropertyName":"Value"}
action 'is.workflow.actions.properties.health.quantity' getDailyNumber(variable sample: 'WFInput'): number {"WFContentItemPropertyName":"Value"}
action 'is.workflow.actions.properties.health.quantity' getSampleStart(variable sample: 'WFInput') {"WFContentItemPropertyName":"Start Date"}
action 'is.workflow.actions.properties.health.quantity' getSampleEnd(variable sample: 'WFInput') {"WFContentItemPropertyName":"End Date"}
action 'is.workflow.actions.gettimebetweendates' minutesSince(variable end: 'WFInput', variable start: 'WFTimeUntilFromDate'): number {"WFTimeUntilUnit":"Minutes"}

// Calculate Statistics takes its list through the Input parameter.
action 'is.workflow.actions.statistics' sumValues(variable values: 'Input'): number {"WFStatisticsOperation":"Sum"}

@acceptedCount = 0
@skippedCalendarCount = 0
const events = findEvents(todayEventsFilter)
for event in events {
    const title = getEventDetail(@event, "Title")
    const calendarName = getEventDetail(@event, "Calendar")
    const startDate = getEventDetail(@event, "Start Date")
    const endDate = getEventDetail(@event, "End Date")
    const startISO = formatTimestamp(startDate, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
    const endISO = formatTimestamp(endDate, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")

    const eventBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
        "kind": "calendar",
        "shortcutVersion": "2.3.9",
        "title": "{title}",
        "calendar": "{calendarName}",
        "start": "{startISO}",
        "end": "{endISO}"
    }, {"Authorization": "{@credential}"})
    const eventResponse = getDictionary(eventBody)
    const eventStatusValue = getValue(eventResponse, "state")
    const eventStatus = getText(eventStatusValue)
    if eventStatus != "accepted" {
        const eventErrorValue = getValue(eventResponse, "error")
        const eventError = getText(eventErrorValue)
        if eventError == "No valid records. Check date, metric values, and event start/end formats" {
            @skippedCalendarCount += 1
        } else {
            alert("Your calendar didn't sync. {eventError}", "Sync stopped")
            stop()
        }
    } else {
        @acceptedCount += 1
    }
}

const today = currentDate()
const day = formatDate(today, "Custom", "yyyy-MM-dd")
const utcOffset = formatDate(today, "Custom", "ZZZZZ")

// Remove today's events that this run did not send, such as deleted or edited ones.
const syncStartedValue = getValue(handshake, "receivedAt")
const syncStarted = getText(syncStartedValue)
formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
    "kind": "calendar_complete",
    "date": "{day}",
    "utcOffset": "{utcOffset}",
    "startedAt": "{syncStarted}"
}, {"Authorization": "{@credential}"})

// Find Health Samples ends the run when a type has no samples, so check which types have recent data first.
const recentSamples = findRecentSamples(recentTypesFilter)
const recentTypeValues = getSampleTypes(recentSamples)
const recentTypes = getText(recentTypeValues)

const stepsMatches = matchText('(?i)steps', recentTypes)
const stepsAvailable = count(stepsMatches)
if stepsAvailable >= 1 {
    const stepDays = findLatestDay(stepsFilter)
    const samples = getFirstItem(stepDays)
    const stepDate = getSampleStart(samples)
    const stepDay = formatDate(stepDate, "Custom", "yyyy-MM-dd")
    const values = getStepValues(samples)
    const totalSteps = sumValues(values)
    if totalSteps >= 1 {
        const totalStepsText = getText(totalSteps)
        const normalizedSteps = replaceText('(?<=\d)[,\s](?=\d{3}(?:\D|$))', "", totalStepsText, true, true)
        // Keep only the number, because the text form of a Health value can include a unit.
        const stepsValue = replaceText('^\D*(\d+(?:\.\d+)?)[\s\S]*$', "$1", normalizedSteps, true, true)
        const healthBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
            "kind": "health",
            "shortcutVersion": "2.3.9",
            "date": "{stepDay}",
            "steps": "{stepsValue}"
        }, {"Authorization": "{@credential}"})
        const healthResponse = getDictionary(healthBody)
        const healthStatusValue = getValue(healthResponse, "state")
        const healthStatus = getText(healthStatusValue)
        if healthStatus != "accepted" {
            const healthErrorValue = getValue(healthResponse, "error")
            const healthError = getText(healthErrorValue)
            alert("Your steps didn't sync. {healthError}", "Sync stopped")
            stop()
        }
        @acceptedCount += 1
    }
}

// A metric with no data today is left out, never sent as zero.
const restingMatches = matchText('(?i)Resting', recentTypes)
const restingAvailable = count(restingMatches)
if restingAvailable >= 1 {
    const restingDays = findLatestDay(restingFilter)
    const restingSamples = getFirstItem(restingDays)
    const restingDate = getSampleStart(restingSamples)
    const restingDay = formatDate(restingDate, "Custom", "yyyy-MM-dd")
    const restingValue = getDailyNumber(restingSamples)
    if restingValue >= 1 {
        const restingBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
            "kind": "health",
            "shortcutVersion": "2.3.9",
            "date": "{restingDay}",
            "restingHR": "{restingValue}"
        }, {"Authorization": "{@credential}"})
        const restingResponse = getDictionary(restingBody)
        const restingStatusValue = getValue(restingResponse, "state")
        const restingStatus = getText(restingStatusValue)
        if restingStatus == "accepted" {
            @acceptedCount += 1
        }
    }
}

const hrvMatches = matchText('(?i)Variability', recentTypes)
const hrvAvailable = count(hrvMatches)
if hrvAvailable >= 1 {
    const hrvDays = findLatestDay(hrvFilter)
    const hrvSamples = getFirstItem(hrvDays)
    const hrvDate = getSampleStart(hrvSamples)
    const hrvDay = formatDate(hrvDate, "Custom", "yyyy-MM-dd")
    const hrvValue = getDailyNumber(hrvSamples)
    if hrvValue >= 1 {
        const hrvBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
            "kind": "health",
            "shortcutVersion": "2.3.9",
            "date": "{hrvDay}",
            "hrv": "{hrvValue}"
        }, {"Authorization": "{@credential}"})
        const hrvResponse = getDictionary(hrvBody)
        const hrvStatusValue = getValue(hrvResponse, "state")
        const hrvStatus = getText(hrvStatusValue)
        if hrvStatus == "accepted" {
            @acceptedCount += 1
        }
    }
}

const exerciseMatches = matchText('(?i)Exercise', recentTypes)
const exerciseAvailable = count(exerciseMatches)
if exerciseAvailable >= 1 {
    const exerciseDays = findLatestDay(exerciseFilter)
    const exerciseSamples = getFirstItem(exerciseDays)
    const exerciseDate = getSampleStart(exerciseSamples)
    const exerciseDay = formatDate(exerciseDate, "Custom", "yyyy-MM-dd")
    const exerciseValue = getDailyNumber(exerciseSamples)
    if exerciseValue >= 1 {
        const workoutBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
            "kind": "health",
            "shortcutVersion": "2.3.9",
            "date": "{exerciseDay}",
            "workoutMin": "{exerciseValue}"
        }, {"Authorization": "{@credential}"})
        const workoutResponse = getDictionary(workoutBody)
        const workoutStatusValue = getValue(workoutResponse, "state")
        const workoutStatus = getText(workoutStatusValue)
        if workoutStatus == "accepted" {
            @acceptedCount += 1
        }
    }
}

showNotification("Synced {@acceptedCount} items. Skipped {@skippedCalendarCount} calendar events.", "Rage Tracker")

// Offer an update after syncing; the user approves installation in Apple Shortcuts.
const releaseBody = downloadURL("https://rage-tracker.bishvili.workers.dev/api/shortcut/release?current=2.3.9", {"Authorization": "{@credential}"})
const releaseInfo = getDictionary(releaseBody)
const updateStatusValue = getValue(releaseInfo, "updateStatus")
const updateStatus = getText(updateStatusValue)
if updateStatus == "new_release" {
    @release = getValue(releaseInfo, "release")
    @link = @release['url']
    const updateOptions = list("Install update", "Not now")
    const selected = chooseFromList(updateOptions, "A new version of Rage Tracker Sync is available.")
    const choice = getText(selected)
    if choice == "Install update" {
        openURL("{link}")
    }
}

// Count only sleep from the last 24 hours.
// Count only time asleep, not time in bed or awake.
const sleepMatches = matchText('(?i)Sleep', recentTypes)
const sleepAvailable = count(sleepMatches)
if sleepAvailable >= 1 {
    @sleepMinutes = 0
    const sleepSamples = findSamples(sleepFilter)
    for sleepSample in sleepSamples {
        const sleepStart = getSampleStart(@sleepSample)
        const sleepAge = minutesSince(today, sleepStart)
        if sleepAge <= 1440 {
            const stageValue = getSampleValue(@sleepSample)
            const stageText = getText(stageValue)
            const stageMatches = matchText('(?i)asleep', stageText)
            const stageCount = count(stageMatches)
            if stageCount >= 1 {
                const sleepEnd = getSampleEnd(@sleepSample)
                const stageMinutes = minutesSince(sleepEnd, sleepStart)
                @sleepMinutes += stageMinutes
            }
        }
    }
    if @sleepMinutes >= 1 {
        const sleepHours = @sleepMinutes / 60
        const sleepBody = formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
            "kind": "health",
            "shortcutVersion": "2.3.9",
            "date": "{day}",
            "sleepHours": "{sleepHours}"
        }, {"Authorization": "{@credential}"})
        const sleepResponse = getDictionary(sleepBody)
        const sleepStatusValue = getValue(sleepResponse, "state")
        const sleepStatus = getText(sleepStatusValue)
        if sleepStatus == "accepted" {
            @acceptedCount += 1
        }
    }
}
