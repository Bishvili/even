#define name Rage Tracker Sync
#define glyph heart
#define color teal
#define mac false

#include 'actions/calendar'
#include 'actions/math'
#include 'actions/text'
#include 'actions/web'

#include 'actions/documents'

// Configuration lives outside the Shortcut so installing an update preserves it.
// Apple Shortcuts stores this under iCloud Drive/Shortcuts/RageTracker.
const currentShortcutVersion = "1.1.0"
@savedCredential = getFile("RageTracker/device-key.txt", nil, false)
@credential = ""
if !@savedCredential {
    alert("Open Rage Tracker > Sync and copy your Authorization header value. Return here to enter it once. It starts with Bearer.", "Connect Rage Tracker")
    @entered = prompt("Paste the complete Authorization value from Rage Tracker", "Text")
    if @entered beginsWith "Bearer " {
        @credential = "{@entered}"
    } else {
        alert("The value must begin with Bearer followed by your private device key. Nothing has been saved.", "Invalid connection")
        stop()
    }
    const verifyRaw = downloadURL("https://rage-tracker.bishvili.workers.dev/api/profile", {"Authorization": "{@credential}"})
    const verified = getDictionary(verifyRaw)
    @verified = getValue(verified, "ok")
    if !@verified {
        alert("Rage Tracker did not accept that device key. Copy the latest value from Sync and try again.", "Connection failed")
        stop()
    }
    createFolder("RageTracker")
    saveFile("RageTracker/device-key.txt", @credential, true)
} else {
    @credential = getText(@savedCredential)
}

// Confirm connectivity independently from the Health and Calendar uploads.
jsonRequest("https://rage-tracker.bishvili.workers.dev/api/shortcut/hello", "POST", {"shortcutVersion": "1.1.0"}, {"Authorization": "{@credential}"})
const helloRaw = downloadURL("https://rage-tracker.bishvili.workers.dev/api/sync/status", {"Authorization": "{@credential}"})
const helloData = getDictionary(helloRaw)
@confirmedVersion = getValue(helloData, "installedShortcutVersion")
if @confirmedVersion != "1.1.0" {
    alert("Rage Tracker did not confirm the Shortcut handshake. Your Health and Calendar data were not sent.", "Connection failed")
    stop()
}

// A version check can open a replacement Shortcut; Apple always requires confirmation.
const latestRaw = downloadURL("https://rage-tracker.bishvili.workers.dev/api/shortcut/release?current=1.1.0", {"Authorization": "{@credential}"})
const latest = getDictionary(latestRaw)
@updateAvailable = getValue(latest, "updateAvailable")
if @updateAvailable {
    @release = getValue(latest, "release")
    @newURL = @release['url']
    const updateOptions = list("Install update", "Continue syncing")
    @choice = chooseFromList(updateOptions, "A new Rage Tracker Sync version is available.")
    if @choice == "Install update" {
        openURL("{@newURL}")
        stop()
    }
}

// Read samples for one day. The Health picker label is "Steps".
action 'is.workflow.actions.filter.health.quantity' findTodaySteps(): array {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {
                    "Bounded": true,
                    "Operator": 4,
                    "Property": "Type",
                    "Removable": false,
                    "Values": {
                        "Enumeration": {
                            "Value": "Steps",
                            "WFSerializationType": "WFStringSubstitutableState"
                        }
                    }
                },
                {
                    "Bounded": true,
                    "Operator": 1002,
                    "Property": "Start Date",
                    "Removable": false,
                    "Values": {"Number": "7", "Unit": 16}
                }
            ]
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    }
}

action 'is.workflow.actions.properties.health.quantity' getStepValues(variable samples: 'WFInput'): array {
    "WFContentItemPropertyName": "Value"
}

// Query events starting today; do not include notes, locations or attendees.
action 'is.workflow.actions.filter.calendarevents' findTodayEvents(): array {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
                {
                    "Bounded": true,
                    "Operator": 1002,
                    "Property": "Start Date",
                    "Removable": true,
                    "Values": {}
                }
            ]
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemLimitEnabled": true,
    "WFContentItemLimitNumber": 50,
    "WFContentItemSortProperty": "Start Date",
    "WFContentItemSortOrder": "Ascending"
}

const current = currentDate()
const today = formatDate(current, "Custom", "yyyy-MM-dd")
@events = findTodayEvents()

for event in @events {
    const title = getEventDetail(@event, "Title")
    const startDate = getEventDetail(@event, "Start Date")
    const endDate = getEventDetail(@event, "End Date")
    const startISO = formatDate(startDate, "ISO 8601")
    const endISO = formatDate(endDate, "ISO 8601")
    @name = lowercase("{title}")
    @category = "Other"

    if @name contains "meeting" || @name contains "call" {
        @category = "Meeting"
    }
    if @name contains "workout" || @name contains "gym" || @name contains "walk" || @name contains "run" {
        @category = "Exercise"
    }
    if @name contains "coffee" || @name contains "lunch" || @name contains "dinner" {
        @category = "Social"
    }
    if @name contains "commute" || @name contains "drive" {
        @category = "Commute"
    }

    formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
        "kind": "calendar",
        "title": "{title}",
        "start": "{startISO}",
        "end": "{endISO}",
        "category": "{@category}"
    }, {"Authorization": "{credential}"})
}

// Skip Health uploads when no samples are available; Calendar can still sync.
@samples = findTodaySteps()
const sampleCount = count(@samples)
if sampleCount > 0 {
    const values = getStepValues(@samples)
    const steps = statistic("Sum", values)
    formRequest("https://rage-tracker.bishvili.workers.dev/api/ingest", "POST", {
        "kind": "health",
        "date": "{today}",
        "steps": "{steps}"
    }, {"Authorization": "{credential}"})
}

show("Rage Tracker connection verified. Data actions completed. Open Rage Tracker > Sync > Test connection to confirm accepted Health and Calendar uploads.")
