#define name Health Sync
#define color teal
#define glyph heart
#define mac false

#include 'actions/calendar'
#include 'actions/text'
#include 'actions/web'

// Filters are passed as references because Cherri rewrites nested action parameters.
#ref todayEventsFilter 
#ref upcomingEventsFilter 
#ref stepsFilter 
#ref restingFilter 
#ref hrvFilter 
#ref exerciseFilter 
#ref sleepFilter 
#ref recentTypesFilter 

// The device key lives in a file outside this Shortcut, in On My iPhone so it works without iCloud Drive.
#ref onMyIPhone eyJkaXNwbGF5TmFtZSI6Ik9uIE15IGlQaG9uZSIsImZpbGVuYW1lIjoiRmlsZSBQcm92aWRlciBTdG9yYWdlIiwiZmlsZUxvY2F0aW9uIjp7IldGRmlsZUxvY2F0aW9uVHlwZSI6IkxvY2FsU3RvcmFnZSIsInJlbGF0aXZlU3VicGF0aCI6IiJ9fQ==

action 'is.workflow.actions.file.createfolder' createKeyFolder(&variable location: 'WFFolder') {"WFFilePath":"Health Sync"}

action 'is.workflow.actions.documentpicker.open' readSavedDeviceKey(&variable folder: 'WFFile'): text {"WFGetFilePath":"device-key.txt","WFFileErrorIfNotFound":false,"WFShowFilePicker":false}

action 'is.workflow.actions.documentpicker.save' saveDeviceKey(variable key: 'WFInput', &variable folder: 'WFFolder') {"WFFileDestinationPath":"device-key.txt","WFSaveFileOverwrite":true,"WFAskWhereToSave":false}

const appAddress = "https://sync.bishvili.org"

const keyFolder = createKeyFolder(onMyIPhone)
// Running from the app passes the key as input, so nothing needs pasting.
@credential = getText(ShortcutInput)
const providedKeyMatches = matchText('^Bearer [0-9A-Fa-f]{64}$', @credential)
const providedKeyCount = count(providedKeyMatches)
if providedKeyCount == 0 {
    const savedKeyFile = readSavedDeviceKey(keyFolder)
    @credential = getText(savedKeyFile)
    const savedKeyMatches = matchText('^Bearer [0-9A-Fa-f]{64}$', @credential)
    const savedKeyMatchCount = count(savedKeyMatches)
    if savedKeyMatchCount == 0 {
        alert("Open the app, go to Data, and tap Run Health Sync.", "Not connected")
        stop()
    }
}

// Verify the connection and record the Shortcut's version, even if no health samples are available.
// The reply also says whether a newer version is ready.
const handshakeRaw = jsonRequest("{appAddress}/api/shortcut/hello", "POST", {
    "shortcutVersion": "4.0.0"
}, {"Authorization": "{@credential}"})
const handshake = getDictionary(handshakeRaw)
const connectionStatusValue = getValue(handshake, "state")
const connectionStatus = getText(connectionStatusValue)
if connectionStatus != "connected" {
    alert("Open the app, go to Data, and tap Run Health Sync to reconnect.", "Not connected")
    stop()
}

// Save only a key the server accepted, so a failed attempt cannot replace a working one.
saveDeviceKey(@credential, keyFolder)

// What to sync is set in the app and arrives with the handshake, so it needs no extra request.
const syncCalendarValue = getValue(handshake, "syncCalendar")
const syncCalendar = getText(syncCalendarValue)
const syncSleepValue = getValue(handshake, "syncSleep")
const syncSleep = getText(syncSleepValue)
const syncStepsValue = getValue(handshake, "syncSteps")
const syncSteps = getText(syncStepsValue)
const syncRestingHRValue = getValue(handshake, "syncRestingHR")
const syncRestingHR = getText(syncRestingHRValue)
const syncHrvValue = getValue(handshake, "syncHrv")
const syncHrv = getText(syncHrvValue)
const syncWorkoutValue = getValue(handshake, "syncWorkout")
const syncWorkout = getText(syncWorkoutValue)
const syncAlarmsValue = getValue(handshake, "syncAlarms")
const syncAlarms = getText(syncAlarmsValue)
const calendarsOffValue = getValue(handshake, "calendarsOff")
const calendarsOff = getText(calendarsOffValue)

// Each upload that's accepted counts once, for the final notification.
@acceptedCount = 0
const today = currentDate()
const day = formatDate(today, "Custom", "yyyy-MM-dd")
const utcOffset = formatDate(today, "Custom", "ZZZZZ")

// Today and the next 7 days go up together, so the server can treat them all as complete.
// Records and fields use separator characters, because a title can contain almost anything else.
action 'is.workflow.actions.filter.calendarevents' findEvents(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":150,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Oldest First"}

if syncCalendar == "on" {
@eventRecords = ""
const todayEvents = findEvents(todayEventsFilter)
for event in todayEvents {
    const title = getEventDetail(@event, "Title")
    const calendarName = getEventDetail(@event, "Calendar")
    const startDate = getEventDetail(@event, "Start Date")
    const endDate = getEventDetail(@event, "End Date")
    const startISO = formatTimestamp(startDate, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
    const endISO = formatTimestamp(endDate, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
    const todayOff = matchText("{calendarsOff}", calendarName)
    const todayOffCount = count(todayOff)
    if todayOffCount == 0 {
        @eventRecords = "{@eventRecords}␞{startISO}␟{endISO}␟{calendarName}␟{title}"
    }
}

// The next 9 days repeat the rest of today and run past the last whole day; the server counts each event once and keeps the 8 days it's told about.
const upcomingEvents = findEvents(upcomingEventsFilter)
for upcomingEvent in upcomingEvents {
    const upcomingTitle = getEventDetail(@upcomingEvent, "Title")
    const upcomingCalendar = getEventDetail(@upcomingEvent, "Calendar")
    const upcomingStart = getEventDetail(@upcomingEvent, "Start Date")
    const upcomingEnd = getEventDetail(@upcomingEvent, "End Date")
    const upcomingStartISO = formatTimestamp(upcomingStart, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
    const upcomingEndISO = formatTimestamp(upcomingEnd, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
    const upcomingOff = matchText("{calendarsOff}", upcomingCalendar)
    const upcomingOffCount = count(upcomingOff)
    if upcomingOffCount == 0 {
        @eventRecords = "{@eventRecords}␞{upcomingStartISO}␟{upcomingEndISO}␟{upcomingCalendar}␟{upcomingTitle}"
    }
}

const calendarBody = formRequest("{appAddress}/api/ingest", "POST", {
    "kind": "calendar_days",
    "calendarDays": "8",
    "shortcutVersion": "4.0.0",
    "date": "{day}",
    "utcOffset": "{utcOffset}",
    "events": "{@eventRecords}"
}, {"Authorization": "{@credential}"})
const calendarResponse = getDictionary(calendarBody)
const calendarStatusValue = getValue(calendarResponse, "state")
const calendarStatus = getText(calendarStatusValue)
// A notification, not an alert, so a scheduled run keeps going.
if calendarStatus != "accepted" {
    const calendarErrorValue = getValue(calendarResponse, "error")
    const calendarError = getText(calendarErrorValue)
    showNotification("Your calendar didn't sync. {calendarError}", "Health Sync")
} else {
    @acceptedCount += 1
}
}

// Daily groups over 30 days give Health's own totals, and a quiet day doesn't end the run.
// The newest group comes first and is usually today, so each value is sent with its group's own date.
// A result limit would apply before grouping and return a single sample.
action 'is.workflow.actions.filter.health.quantity' findLatestDay(&variable filter: 'WFContentItemFilter'): array {"WFHKSampleFilteringGroupBy":"Day","WFHKSampleFilteringFillMissing":true,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

// Recent sleep samples, newest first. The server needs to know when the limit was reached, because the oldest night may be cut off.
action 'is.workflow.actions.filter.health.quantity' findSamples(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":100,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

// The newest samples of any type. A filter can't both match several types and limit dates, so a result limit bounds it.
action 'is.workflow.actions.filter.health.quantity' findRecentSamples(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":1000,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.filter.health.quantity' findSleepHistory(&variable filter: 'WFContentItemFilter'): array {"WFContentItemLimitEnabled":true,"WFContentItemLimitNumber":300,"WFContentItemSortProperty":"Start Date","WFContentItemSortOrder":"Latest First"}

action 'is.workflow.actions.properties.health.quantity' getSampleTypes(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Type"}

action 'is.workflow.actions.properties.health.quantity' getStepValues(variable samples: 'WFInput'): array {"WFContentItemPropertyName":"Value"}

action 'is.workflow.actions.properties.health.quantity' getSampleValue(variable sample: 'WFInput') {"WFContentItemPropertyName":"Value"}
action 'is.workflow.actions.properties.health.quantity' getDailyNumber(variable sample: 'WFInput'): number {"WFContentItemPropertyName":"Value"}
action 'is.workflow.actions.properties.health.quantity' getSampleStart(variable sample: 'WFInput') {"WFContentItemPropertyName":"Start Date"}
action 'is.workflow.actions.properties.health.quantity' getSampleEnd(variable sample: 'WFInput') {"WFContentItemPropertyName":"End Date"}

// Calculate Statistics takes its list through the Input parameter.
action 'is.workflow.actions.statistics' sumValues(variable values: 'Input'): number {"WFStatisticsOperation":"Sum"}

// Every measure goes up in one request. Anything with no data stays empty and is left out, never sent as zero.
@healthFields = 0
@stepsField = ""
@restingField = ""
@hrvField = ""
@exerciseField = ""
@sleepIntervals = ""
@sleepCount = "0"
@sleepLimit = "100"

// Find Health Samples ends the run when a type has no samples, so check which types have recent data first.
const recentSamples = findRecentSamples(recentTypesFilter)
const recentTypeValues = getSampleTypes(recentSamples)
const recentTypes = getText(recentTypeValues)
const recentTypeCount = count(recentTypeValues)

// Up to 7 days of each measure, so a day when Health Sync didn't run is filled in on the next one.
if syncSteps == "on" {
const stepsMatches = matchText('(?i)steps', recentTypes)
const stepsAvailable = count(stepsMatches)
if stepsAvailable >= 1 {
    @stepDays = findLatestDay(stepsFilter)
    @stepsSeen = 0
    for stepGroup in @stepDays {
        if @stepsSeen < 7 {
            const stepDate = getSampleStart(@stepGroup)
            const stepDay = formatDate(stepDate, "Custom", "yyyy-MM-dd")
            const values = getStepValues(@stepGroup)
            const totalSteps = sumValues(values)
            if totalSteps >= 1 {
                const totalStepsText = getText(totalSteps)
                const normalizedSteps = replaceText('(?<=\d)[,\s](?=\d{3}(?:\D|$))', "", totalStepsText, true, true)
                // Keep only the number, because the text form of a Health value can include a unit.
                const stepsValue = replaceText('^\D*(\d+(?:\.\d+)?)[\s\S]*$', "$1", normalizedSteps, true, true)
                @stepsField = "{@stepsField}␞{stepDay}={stepsValue}"
                @stepsSeen += 1
            }
        }
    }
    if @stepsSeen >= 1 {
        @healthFields += 1
    }
}
}

if syncRestingHR == "on" {
const restingMatches = matchText('(?i)Resting', recentTypes)
const restingAvailable = count(restingMatches)
if restingAvailable >= 1 {
    @restingDays = findLatestDay(restingFilter)
    @restingSeen = 0
    for restingGroup in @restingDays {
        if @restingSeen < 7 {
            const restingDate = getSampleStart(@restingGroup)
            const restingDay = formatDate(restingDate, "Custom", "yyyy-MM-dd")
            const restingValue = getDailyNumber(@restingGroup)
            if restingValue >= 1 {
                @restingField = "{@restingField}␞{restingDay}={restingValue}"
                @restingSeen += 1
            }
        }
    }
    if @restingSeen >= 1 {
        @healthFields += 1
    }
}
}

if syncHrv == "on" {
const hrvMatches = matchText('(?i)Variability', recentTypes)
const hrvAvailable = count(hrvMatches)
if hrvAvailable >= 1 {
    @hrvDays = findLatestDay(hrvFilter)
    @hrvSeen = 0
    for hrvGroup in @hrvDays {
        if @hrvSeen < 7 {
            const hrvDate = getSampleStart(@hrvGroup)
            const hrvDay = formatDate(hrvDate, "Custom", "yyyy-MM-dd")
            const hrvValue = getDailyNumber(@hrvGroup)
            if hrvValue >= 1 {
                @hrvField = "{@hrvField}␞{hrvDay}={hrvValue}"
                @hrvSeen += 1
            }
        }
    }
    if @hrvSeen >= 1 {
        @healthFields += 1
    }
}
}

if syncWorkout == "on" {
const exerciseMatches = matchText('(?i)Exercise', recentTypes)
const exerciseAvailable = count(exerciseMatches)
if exerciseAvailable >= 1 {
    @exerciseDays = findLatestDay(exerciseFilter)
    @exerciseSeen = 0
    for exerciseGroup in @exerciseDays {
        if @exerciseSeen < 7 {
            const exerciseDate = getSampleStart(@exerciseGroup)
            const exerciseDay = formatDate(exerciseDate, "Custom", "yyyy-MM-dd")
            const exerciseValue = getDailyNumber(@exerciseGroup)
            if exerciseValue >= 1 {
                @exerciseField = "{@exerciseField}␞{exerciseDay}={exerciseValue}"
                @exerciseSeen += 1
            }
        }
    }
    if @exerciseSeen >= 1 {
        @healthFields += 1
    }
}
}

// Each asleep sample goes up as its start and end. The server merges overlapping samples from more than one device
// and files each night under the morning it ends, so time in bed, awake time and naps don't count.
if syncSleep == "on" {
const sleepMatches = matchText('(?i)Sleep', recentTypes)
const sleepAvailable = count(sleepMatches)
if sleepAvailable >= 1 {
    // The first sync reads up to a month back, so the bedtime estimate works straight away.
    @sleepSamples = findSamples(sleepFilter)
    const historyValue = getValue(handshake, "sleepHistory")
    const historyState = getText(historyValue)
    if historyState == "needed" {
        @sleepSamples = findSleepHistory(sleepFilter)
        @sleepLimit = "300"
    }
    const sleepSampleCount = count(@sleepSamples)
    @sleepCount = "{sleepSampleCount}"
    for sleepSample in @sleepSamples {
        const stageValue = getSampleValue(@sleepSample)
        const stageText = getText(stageValue)
        const stageMatches = matchText('(?i)asleep', stageText)
        const stageCount = count(stageMatches)
        if stageCount >= 1 {
            const sleepStart = getSampleStart(@sleepSample)
            const sleepEnd = getSampleEnd(@sleepSample)
            const sleepStartISO = formatTimestamp(sleepStart, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
            const sleepEndISO = formatTimestamp(sleepEnd, "Custom", "None", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
            @sleepIntervals = "{@sleepIntervals}␞{sleepStartISO}␟{sleepEndISO}"
        }
    }
    @healthFields += 1
}
}

if @healthFields >= 1 {
    const healthBody = formRequest("{appAddress}/api/ingest", "POST", {
        "kind": "health",
        "shortcutVersion": "4.0.0",
        "date": "{day}",
        "stepsRecent": "{@stepsField}",
        "restingHRRecent": "{@restingField}",
        "hrvRecent": "{@hrvField}",
        "workoutMinRecent": "{@exerciseField}",
        "sleepIntervals": "{@sleepIntervals}",
        "sleepSamples": "{@sleepCount}",
        "sleepLimit": "{@sleepLimit}"
    }, {"Authorization": "{@credential}"})
    const healthResponse = getDictionary(healthBody)
    const healthStatusValue = getValue(healthResponse, "state")
    const healthStatus = getText(healthStatusValue)
    if healthStatus != "accepted" {
        const healthErrorValue = getValue(healthResponse, "error")
        const healthError = getText(healthErrorValue)
        showNotification("Your Health data didn't sync. {healthError}", "Health Sync")
    } else {
        @acceptedCount += 1
    }
}

// Offer an update after syncing; the user approves installation in Apple Shortcuts.
const updateStatusValue = getValue(handshake, "updateStatus")
const updateStatus = getText(updateStatusValue)
// A notification, because a question would stall a scheduled run.
if updateStatus == "new_release" {
    showNotification("A new version is ready in the app.", "Health Sync")
}

// Alarms come last, because Shortcuts can't catch an error and the earlier data is already saved.
// Their details are only available as variable properties. Separators are unlikely in a label and survive multi-line repeats.
if syncAlarms == "on" {
@alarmRecords = ""
const alarms = getAlarms()
for alarm in alarms {
    const alarmClock = formatDate(@alarm['Time'], "Custom", "HH:mm")
    @alarmRecords = "{@alarmRecords}␞{alarmClock}␟{@alarm['Repeat']}␟{@alarm['Is Enabled']}␟{@alarm['Name']}"
}
formRequest("{appAddress}/api/ingest", "POST", {
    "kind": "alarms",
    "shortcutVersion": "4.0.0",
    "date": "{day}",
    "alarms": "{@alarmRecords}"
}, {"Authorization": "{@credential}"})
}

// A push opens the app and brings the data in. Without notifications on, fall back to a plain notification.
const syncedRaw = jsonRequest("{appAddress}/api/push/synced", "POST", {
    "items": "{@acceptedCount}",
    "healthSeen": "{recentTypeCount}",
    "healthMatched": "{@healthFields}"
}, {"Authorization": "{@credential}"})
const synced = getDictionary(syncedRaw)
const syncedValue = getValue(synced, "state")
const syncedState = getText(syncedValue)
if syncedState != "sent" {
    showNotification("Sync finished. Open the app to see it.", "Health Sync")
}
