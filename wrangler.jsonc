{
  "name": "even",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "dist",
    "binding": "STATIC",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "ASSETS",
      "id": "22aa6c748a8c436cafef2e87b8522c19"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "even-private",
      "database_id": "e489c042-ef73-49e3-a332-f28df4371b93",
      "migrations_dir": "db/migrations"
    }
  ]
}
