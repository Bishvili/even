{
  "name": "health",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://health.bishvili.org",
    "SHORTCUT_ORIGIN": "https://sync.bishvili.org",
    "APP_ORIGINS": "https://even.bishvili.org,https://health.bishvili.org"
  },
  "routes": [{ "pattern": "even.bishvili.org", "custom_domain": true },
    { "pattern": "health.bishvili.org", "custom_domain": true },
    { "pattern": "sync.bishvili.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    { "name": "INVITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "DEVICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "SIGNIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
    { "name": "SEND_LIMIT", "namespace_id": "1004", "simple": { "limit": 1, "period": 60 } },
    { "name": "NETWORK_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "dist",
    "binding": "STATIC",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "ASSETS",
      "id": "22aa6c748a8c436cafef2e87b8522c19"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-private",
      "database_id": "98a89332-ae2d-4d6e-9fae-ada2080e8956",
      "migrations_dir": "db/migrations"
    }
  ]
}
