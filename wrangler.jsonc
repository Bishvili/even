{
  "name": "even",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://even.bishvili.workers.dev"
  },
  "ratelimits": [
    { "name": "INVITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "DEVICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "SIGNIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }
  ],
  "kv_namespaces": [
    {
      "binding": "ASSETS",
      "id": "22aa6c748a8c436cafef2e87b8522c19"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "even-private",
      "database_id": "e489c042-ef73-49e3-a332-f28df4371b93",
      "migrations_dir": "db/migrations"
    }
  ]
}
